<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for a new outbox.cafe scheduled job. crontab WRITES hang on this
     Mini (TCC prompt; see CLAUDE.md), so new schedules install as launchd
     agents instead: copy to ~/Library/LaunchAgents/dev.stanwood.outbox-<job>.plist,
     replace JOBNAME + the schedule, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.stanwood.outbox-<job>.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.stanwood.outbox-JOBNAME</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>/Users/stephenstanwood/Projects/outbox-cafe/scripts/run-JOBNAME.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/stephenstanwood/logs/outbox-JOBNAME.log</string>
  <key>StandardErrorPath</key><string>/Users/stephenstanwood/logs/outbox-JOBNAME.log</string>
</dict>
</plist>
